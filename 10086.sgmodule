#!name=中国移动去开屏广告
#!desc=基于实抓请求：REJECT广告埋点+清洗启动配置接口
#!system=ios

[MITM]
hostname = %APPEND% client.app.coc.10086.cn, clientaccess.10086.cn, wap.js.10086.cn, apm.app.coc.10086.cn, h5.bj.10086.cn, h.app.coc.10086.cn, jiguang.coc.10086.cn

[Rule]
# 广告/埋点/隐私追踪域名直接掐断
DOMAIN-SUFFIX,jiguang.coc.10086.cn,REJECT
DOMAIN-SUFFIX,upc.zztfly.com,REJECT
DOMAIN-SUFFIX,push.it.10086.cn,REJECT

# 启动阶段广告配置接口（参考同类规则库实测命中）
URL-REGEX,^https?:\/\/clientaccess\.10086\.cn\/biz-orange\/DN\/init\/startInit,REJECT
URL-REGEX,^https?:\/\/wap\.js\.10086\.cn\/jsmccClient\/cd\/market_content\/api\/.+\/market_content\.page\.query,REJECT

[Script]
# 兜底：清洗启动配置响应里的广告字段
10086 = type=http-response,pattern=^https?:\/\/(client(app)?|apm|h5|clientaccess|wap)\..*10086\.cn\/.*(init|start|splash|config|boot|ad|adv|popup|market).*,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/BeckChenZ/rule/refs/heads/main/10086.js,debug=1
